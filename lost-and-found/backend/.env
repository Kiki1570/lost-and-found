PORT=5000
MONGO_URI=mongodb://localhost:27017/lostandfound
JWT_SECRET=lostfound_super_secret_jwt_key_2026_secure
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
NODE_ENV=development

# Cloudinary (for image uploads) - replace with your credentials
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email - replace with your credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Lost & Found <noreply@lostandfound.com>

FRONTEND_URL=http://localhost:3000
